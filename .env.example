# --- Qloo (hackathon) ---------------------------------------------------------
# Leave QLOO_API_KEY empty (or set QLOO_MOCK=1) to run on synthetic fixtures.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_MOCK=1
# Optional: comma-separated venue tag IDs from /v2/tags (skips runtime discovery)
QLOO_VENUE_TAGS=
# Optional private disk cache. Keep it OUTSIDE the repo; never commit Qloo data.
QLOO_CACHE_DIR=
# Overrides for strings still to verify live (see docs/QLOO_VERIFY.md)
# QLOO_TYPE_DESTINATION=urn:entity:destination
# QLOO_TYPE_HEATMAP=urn:heatmap
# QLOO_HEATMAP_BOUNDARY=
# QLOO_PATH_COMPARE=/v2/analysis/compare
# OPENER_MIN_HEAT=0.6

# --- LLM: any OpenAI-compatible /chat/completions with tool calling ----------
# Default: OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Alternative: Nebius Token Factory
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LLM_MODEL=<a tool-calling model id from your Token Factory console>
# Leave LLM_API_KEY empty or set LLM_MOCK=1 for the scripted mock model.
LLM_MOCK=

# --- Optional LangSmith tracing ---------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=roadie
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- App ----------------------------------------------------------------------
PREWARM=1
RATE_LIMIT_PER_10MIN=12
